<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- SparkleConnect fullscreen theme: no action bar, no status bar, no nav bar -->
    <style name="Theme.SparkleConnect" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Make the splash/initial window background match the app bg -->
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Hide status bar -->
        <item name="android:windowFullscreen">true</item>
        <!-- Allow drawing under system bars (edge-to-edge) -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Transparent status + nav bar so our content bleeds through -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Smooth window enter animation -->
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

</resources>
